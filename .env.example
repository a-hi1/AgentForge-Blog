# ==================== API 配置 ====================
# 你的 LLM API Key（必填）
# 支持 OpenAI / 智谱GLM / DeepSeek 等兼容 API
# 智谱API Key 获取: https://open.bigmodel.cn/usercenter/apikeys
# DeepSeek API Key: https://platform.deepseek.com/
OPENAI_API_KEY=your_api_key_here

# API 基础 URL
# DeepSeek: https://api.deepseek.com/v1
# 智谱AI: https://open.bigmodel.cn/api/paas/v4
# OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ==================== 模型选择 ====================
# DeepSeek: deepseek-chat, deepseek-reasoner
# 智谱AI: glm-4-flash, glm-4-air, glm-4
OPENAI_MODEL=deepseek-chat

# 向量模型（可选；DeepSeek 对话 API 无官方 embedding 时会自动走本地哈希回退）
# OpenAI: text-embedding-3-small
# 智谱: embedding-2 / embedding-3
# EMBEDDING_MODEL=

# ==================== Supabase 配置 ====================
# 数据库与向量检索 (pgvector)
# 创建 Supabase 项目: https://supabase.com/dashboard
# 然后在 Project Settings > API 中找到以下值
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================== 可选 ====================
# 提高 GitHub API 限额（仓库导入功能）
GITHUB_TOKEN=

# 最大 Token 数（可选，默认为 3000）
MAX_TOKENS=4096

# 温度参数（可选，范围 0-2，默认为 0.7）
TEMPERATURE=0.7
